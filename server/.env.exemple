PRODUCTION=false

PORT="4000"

REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Root access
DATABASE_HOST="your_database_host_here"
DATABASE_PORT=3306
DATABASE_USERNAME="your_database_username_here"
DATABASE_PASSWORD="your_database_password_here"

# This database will be created from the root
DATABASE_NAME="your_DATABASE_here"

JWT_TOKEN="your_jwt_token_here"
JWT_EXPIRE="7d"

REFRESH_TOKEN="your_refresh_token_here"
REFRESH_EXPIRE="7d"

COOKIE_TOKEN="your_cookie_token_here"

FRONT_END_URL="http://localhost:5173"
BACK_END_URL="http://localhost:4000"

# Opcional: domínio explícito para cookies httpOnly em produção.
# Se omitido, é derivado automaticamente do hostname de FRONT_END_URL.
# Ex.: COOKIE_DOMAIN=.example.com  (ponto inicial inclui subdomínios)
# COOKIE_DOMAIN=

# Upload de plugins no dashboard: caminho absoluto da pasta `plugins` usada pelo processo do core (deve ser a mesma em disco).
# Ex.: /home/user/Fragment-source/core/plugins
# FRAGMENT_CORE_PLUGINS_DIR=

# STORAGE_TYPE="memory" # Database will be cleaned
STORAGE_TYPE="local"
LOCAL_STORAGE_PATH="storage"

# GitHub Releases — catálogo e downloads (área "Distribuição" no dashboard)
GITHUB_RELEASES_REPO=Ashu11-A/Fragment-source
GITHUB_RELEASES_DEFAULT_TAG=v0.0.5-canary
# GITHUB_TOKEN=   # opcional: aumenta o rate limit da API pública

DISCORD_CLIENT_ID=seu_client_id
DISCORD_CLIENT_SECRET=seu_client_secret
# Obrigatório: segredo exclusivo para OAuth state (ex.: openssl rand -hex 32). Não use o mesmo valor de JWT_TOKEN.
OAUTH_STATE_SECRET=gerar_um_segredo_longo_e_aleatorio
# URIs de callback permitidas, separadas por vírgula.
# A URI derivada de FRONT_END_URL ({origin}/login/discord/callback) já é incluída automaticamente.
# Use esta variável apenas para adicionar origens extras (ex.: app mobile, staging).
# DISCORD_ALLOWED_REDIRECT_URIS=https://staging.example.com/login/discord/callback