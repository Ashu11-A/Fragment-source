{
  "name": "server",
  "version": "1.0.0",
  "main": "dist/app.js",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "private": "true",
  "scripts": {
    "dev": "bun run --inspect=ws://localhost:6499 src/app.ts",
    "start": "bun --watch src/cluster.ts",
    "lint": "eslint --fix .",
    "typeorm": "typeorm-ts-node-esm -d ./src/database/dataSource.ts",
    "schema:sync": "bun run typeorm -- schema:sync",
    "typeorm:cache": "bun run typeorm -- cache:clear",
    "schema:drop": "bun run typeorm -- schema:drop",
    "migration:generate": "bun run typeorm -- migration:generate ./src/database/migration/schema-update",
    "migration:show": "bun run typeorm -- migration:show",
    "migration:run": "bun run typeorm -- migration:run",
    "migration:revert": "bun run typeorm -- migration:revert",
    "seed": "bun run src/scripts/seed.ts"
  },
  "keywords": [],
  "author": {
    "email": "Matheusn.biolowons@gmail.com",
    "name": "Ashu11-A",
    "url": "https://github.com/Ashu11-A"
  },
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/socket.io": "^3.0.2",
    "eslint": "^9.39.4",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@keyv/valkey": "^1.0.11",
    "@socket.io/cluster-adapter": "^0.3.0",
    "@trpc/server": "^11.16.0",
    "@types/semver": "^7.7.1",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "discord-oauth": "workspace:../packages/discord-oauth",
    "dotenv": "^16.6.1",
    "env": "workspace:../packages/env",
    "fastify": "^5.8.5",
    "fastify-raw-body": "^5.0.0",
    "fastify-socket.io": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "keyv": "^5.6.0",
    "mysql2": "^3.22.0",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.7.4",
    "socket": "workspace:../packages/socket",
    "sql.js": "^1.14.1",
    "storage": "workspace:../packages/storage",
    "typeorm": "^0.3.28",
    "zod": "^3.25.76"
  }
}
