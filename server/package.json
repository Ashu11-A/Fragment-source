    "reflect-metadata": "^0.2.2",
    "socket": "workspace:../packages/socket",
    "sql.js": "^1.14.1",
    "storage": "workspace:../packages/storage",
    "typeorm": "^0.3.28",
    "typescript-eslint": "^8.58.2",
    "zod": "^3.25.76"
  }
