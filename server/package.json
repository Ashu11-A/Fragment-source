{
  "name": "server",
  "version": "1.0.0",
  "main": "dist/app.js",
  "module": "build/exports.ts",
  "types": "build/exports.ts",
  "type": "module",
  "private": "true",
  "scripts": {
    "dev": "bun run --inspect=ws://localhost:6499 src/app.ts",
    "start": "bun --watch src/cluster.ts",
    "lint": "eslint --fix .",
    "typeorm": "typeorm-ts-node-esm -d ./src/database/dataSource.ts",
    "schema:sync": "bun run typeorm -- schema:sync",
    "typeorm:cache": "bun run typeorm -- cache:clear",
    "schema:drop": "bun run typeorm -- schema:drop",
    "migration:generate": "bun run typeorm -- migration:generate ./src/database/migration/schema-update",
    "migration:show": "bun run typeorm -- migration:show",
    "migration:run": "bun run typeorm -- migration:run",
    "migration:revert": "bun run typeorm -- migration:revert"
  },
  "keywords": [],
  "author": {
    "email": "Matheusn.biolowons@gmail.com",
    "name": "Ashu11-A",
    "url": "https://github.com/Ashu11-A"
  },
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^9.9.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/moment": "^2.13.0",
    "@types/sharp": "^0.32.0",
    "@types/socket.io": "^3.0.2",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@socket.io/cluster-adapter": "^0.3.0",
    "@trpc/server": "^11.16.0",
    "bcryptjs": "^3.0.3",
    "bull": "4.16.3",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "env": "workspace:../packages/env",
    "fastify": "^5.8.5",
    "fastify-socket.io": "^5.1.0",
    "glob": "11.0.0",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "moment": "^2.30.1",
    "mysql2": "^3.22.0",
    "nanoid": "^5.1.9",
